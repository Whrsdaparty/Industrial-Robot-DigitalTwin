  <types>
    <dataTypes>
      <dataType name="E_MachineState">
        <baseType>
          <enum>
            <values>
              <value name="Idle" value="0" />
              <value name="Starting" value="1" />
              <value name="Running" value="2" />
              <value name="Stopping" value="3" />
              <value name="Faulted" value="4" />
            </values>
          </enum>
        </baseType>
        <documentation>
          <xhtml:xhtml>Machine operating state.</xhtml:xhtml>
        </documentation>
      </dataType>
      <dataType name="ST_MotorStatus">
        <baseType>
          <struct>
            <variable name="Ready">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Running">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Faulted">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Starts">
              <type>
                <UDINT />
              </type>
            </variable>
          </struct>
        </baseType>
        <documentation>
          <xhtml:xhtml>Normalized motor status.</xhtml:xhtml>
        </documentation>
      </dataType>
      <dataType name="A_ZoneEnabled">
        <baseType>
          <array>
            <dimension lower="1" upper="8" />
            <baseType>
              <BOOL />
            </baseType>
          </array>
        </baseType>
        <documentation>
          <xhtml:xhtml>Zone enable flags.</xhtml:xhtml>
        </documentation>
      </dataType>
    </dataTypes>
    <pous>
      <pou name="MainProgram" pouType="program">
        <interface>
          <localVars>
            <variable name="MachineState">
              <type>
                <derived name="E_MachineState" />
              </type>
              <initialValue>
                <simpleValue value="Idle" />
              </initialValue>
              <documentation>
                <xhtml:xhtml>Current sequence state.</xhtml:xhtml>
              </documentation>
            </variable>
          </localVars>
          <inputVars>
            <variable name="StartPB">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml:xhtml>Start pushbutton input.</xhtml:xhtml>
              </documentation>
            </variable>
            <variable name="StopPB">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml:xhtml>Stop pushbutton input.</xhtml:xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="MotorRunCmd">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml:xhtml>Conveyor motor run command.</xhtml:xhtml>
              </documentation>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml:xhtml>(* Simplified example only *)
IF StopPB THEN
    MotorRunCmd := FALSE;
    MachineState := E_MachineState.Stopping;
ELSIF StartPB THEN
    MotorRunCmd := TRUE;
    MachineState := E_MachineState.Running;
END_IF;
</xhtml:xhtml>
          </ST>
        </body>
        <documentation>
          <xhtml:xhtml>Primary cyclic conveyor program.</xhtml:xhtml>
        </documentation>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations>
      <configuration name="ConveyorCellConfig">
        <resource name="PLC_1">
          <task name="MainTask" priority="1" interval="T#50ms">
            <pouInstance name="MainInstance" typeName="MainProgram" />
            <documentation>
              <xhtml:xhtml>Primary cyclic task.</xhtml:xhtml>
            </documentation>
          </task>
        </resource>
        <globalVars retain="true">
          <variable name="CycleCount">
            <type>
              <UDINT />
            </type>
            <initialValue>
              <simpleValue value="0" />
            </initialValue>
            <documentation>
              <xhtml:xhtml>Retained production cycle count.</xhtml:xhtml>
            </documentation>
          </variable>
        </globalVars>
      </configuration>
    </configurations>
  </instances>
